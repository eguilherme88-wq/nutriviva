# Copie para .env e preencha. Nunca publique o arquivo .env nem a chave da conta de serviço.
PORT=3000

# ---------- WhatsApp (Meta) ----------
# Texto livre que você inventa e repete no painel da Meta ao configurar o webhook
VERIFY_TOKEN=troque-por-um-texto-secreto
# App Dashboard → Configurações do app → Básico → Chave secreta do app
APP_SECRET=
# Token permanente de usuário do sistema (Business Manager) com whatsapp_business_messaging
WHATSAPP_TOKEN=
# WhatsApp → Configuração da API → Identificação do número de telefone
PHONE_NUMBER_ID=
GRAPH_VERSION=v26.0

# ---------- Firebase ----------
# Console do Firebase → Configurações do projeto → Contas de serviço → Gerar nova chave privada.
# Informe o caminho do arquivo .json baixado (ou cole o conteúdo JSON inteiro numa linha).
FIREBASE_SERVICE_ACCOUNT=./service-account.json

# Endereço da plataforma enviado ao paciente para o login no dia da consulta
SITE_URL=https://eguilherme88-wq.github.io/nutriviva/
TZ=America/Sao_Paulo
